# Copie para .env e preencha para rodar `npm run dev` localmente.
# Em produção e preview quem vale são as env vars do projeto na Vercel —
# este arquivo não é lido pelo deploy.
#
# Todos os valores abaixo são públicos por natureza: a anon key é protegida
# por RLS e a chave VAPID pública vai no bundle de qualquer forma. Nada de
# service_role, RESEND_API_KEY ou OPENAI_API_KEY aqui — segredo de servidor
# mora em `supabase secrets set`.

VITE_SUPABASE_PROJECT_ID="mxouphopjfoxtfxpfnde"
VITE_SUPABASE_URL="https://mxouphopjfoxtfxpfnde.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_VAPID_PUBLIC_KEY=""
